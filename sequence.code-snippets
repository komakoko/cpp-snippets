      "\tconst ll INF = 1e18;",
      "\tvector<ll> len(A.size() + 1, -INF);",
      "\tlen[0] = INF;",
      "\trep(i, A.size()) {",
      "\t\tint pos = lower_bound(len.begin(), len.end(), A[i], greater<ll>()) - len.begin(); // A[i] > A[i+1]",
      "\t\t// int pos = upper_bound(len.begin(), len.end(), A[i], greater<ll>()) - len.begin(); // A[i] >= A[i+1]",
