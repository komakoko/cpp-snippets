    ],
    "body": [
      "vector<ll> colors(n, 0); // 0:未訪問 1, -1: 色分け済み",
      "auto dfs = [&](auto self, ll u, ll color) -> void {",
      "\tcolors[u] = color;",
      "\tfor(auto v : adj[u]) {",
