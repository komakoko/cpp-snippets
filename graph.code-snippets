  "dijkstra": {
    "scope": "cpp",
    "prefix": [
      "dijkstra",
      "ダイクストラ法"
    ],
    "body": [
      "vector<ll> dist(n, 1LL<<60);",
      "priority_queue< pll, vector<pll>, greater<pll> > pq;",
      "pq.push({0, 0}); // {始点での累積重み, 始点}",
      "while(!pq.empty()) {",
      "\tauto [d, u] = pq.top(); pq.pop();",
      "\tif(dist[u] <= d) continue;",
      "\tdist[u] = d;",
      "\tfor(auto[v, w] : adj[u]) {",
      "\t// adj : 隣接頂点 重みの順",
      "\t\tif(dist[v] <= d + w) continue;",
      "\t\tpq.push({d + w, v});",
      "\t}",
      "}"
    ],
    "description": "ダイクストラ法"
  },
  "bfs": {
    "scope": "cpp",
    "prefix": "BFS",
    "body": [
      "auto bfs = [&](const vector<ll> &start_points, const vector<vector<ll>> &adj) -> vector<ll> {",
      "\tvector<ll> dist(adj.size(), -1);",
      "\tqueue<ll> queue_bfs;",
      "\tfor (ll start_point : start_points) {",
      "\t\tqueue_bfs.push(start_point);",
      "\t\tdist[start_point] = 0;",
      "\t}",
      "\twhile (!queue_bfs.empty()) {",
      "\t\tll u = queue_bfs.front();",
      "\t\tqueue_bfs.pop();",
      "\t\tfor (auto v : adj[u])",
      "\t\t\tif (dist[v] == -1) {",
      "\t\t\t\tdist[v] = dist[u] + 1;",
      "\t\t\t\tqueue_bfs.push(v);",
      "\t\t\t}",
      "\t}",
      "\treturn dist;",
      "};"
    ],
    "description": "幅優先探索"
  },
  "dfs": {
    "scope": "cpp",
    "prefix": "dfs",
    "body": [
      "vector<bool> visited(n, false);",
      "auto dfs = [&](auto self, ll u) -> void {",
      "\tvisited[u] = true;",
      "\tfor(auto v : adj[u]) {",
      "\t\tif(visited[v]) continue;",
      "\t\tself(self, v);",
      "\t}",
      "};",
      "dfs(dfs, 0);"
    ]
  },
  "bipartite_graph_paint(DFS)": {
