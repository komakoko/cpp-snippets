    "description": "二部グラフの塗り分け(DFS)"
  },
  "floyd_warshall": {
    "scope": "cpp",
    "prefix": [
      "floyd_warshall",
      "warshall_floyd",
      "ワ―シャルフロイド法"
    ],
    "body": [
      "vector<vector<ll>> dist(n, vector<ll>(n, 1LL<<60));",
      "\trep(i, n) dist[i][i] = 0;",
      "\t",
      "\t// 辺の重みを入力する",
      "\trep(i, m) {",
      "\t\tll u, v, w;",
      "\t\tcin >> u >> v >> w; u--; v--;",
      "\t\tdist[u][v] = min(dist[u][v], w);",
      "\t\tdist[v][u] = min(dist[v][u], w);",
      "\t}",
      "\t",
      "\t// 最短路を計算する",
      "\trep(i, k) {",
      "\t\trep(i, n) {",
      "\t\t\trep(j, n) {",
      "\t\t\t\tdist[i][j] = min(dist[i][j], dist[i][k] + dist[k][j]);",
      "\t\t\t}",
      "\t\t}",
      "\t}"
    ],
    "description": "ワ―シャルフロイド法"
  },
  "bfs_01": {
