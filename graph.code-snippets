    "body": [
      "auto bfs = [&](ll start_point, const vector<vector<pll>>& adj) -> vector<ll> {",
      "\tvector<ll> dist(adj.size(), 1<<30);",
      "\tdeque<ll> dq;",
      "",
      "\tdist[start_point] = 0; dq.push_front(start_point);",
      "",
      "\twhile(!dq.empty()) {",
      "\t\tint u = dq.front(); dq.pop_front();",
      "\t\tfor(auto [v, w] : adj[u]) {",
      "\t\t\tif(dist[v] > dist[u] + w) {",
      "\t\t\t\tdist[v] = dist[u] + w;",
      "\t\t\t\tif(w == 0) {",
      "\t\t\t\t\tdq.push_front(v); // コスト0なら先頭へ",
      "\t\t\t\t} else {",
      "\t\t\t\t\tdq.push_back(v);  // コスト1なら末尾へ",
      "\t\t\t\t}",
      "\t\t\t}",
      "\t\t}",
      "\t}",
      "\treturn dist;",
      "};"
    ]
  },
