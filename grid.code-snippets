  "bfs_grid": {
    "scope": "cpp",
    "prefix": "bfs_grid",
    "body": [
      "ll dy[] = {1, -1, 0, 0};",
      "ll dx[] = {0, 0, 1, -1};",
      "auto gridok = [&](ll y, ll x) {",
      "\tif(y < 0 || x < 0 || y >= h || x >= w) return false;",
      "\treturn true;",
      "};",
      "vector<vector<ll>> dist(h, vector<ll>(w, -1));",
      "queue<pll> queue_bfs;",
      "queue_bfs.push({0, 0}); dist[0][0] = 0;",
      "while(!queue_bfs.empty()) {",
      "\tauto [y, x] = queue_bfs.front(); queue_bfs.pop();",
      "\tfor(ll i = 0; i < 4; i++) {",
      "\t\tint next_y = y + dy[i];",
      "\t\tint next_x = x + dx[i];",
      "\t\t// 壁などがあればcontinue",
      "",
      "\t\tif(!gridok(next_y, next_x) || dist[next_y][next_x] != -1) continue;",
      "\t\tdist[next_y][next_x] = dist[y][x] + 1;",
      "\t\tqueue_bfs.push({next_y, next_x});",
      "\t}",
      "}"
    ]
  },
  "bfs_grid_01": {
    "scope": "cpp",
    "prefix": "bfs_grid_01",
    "body": [
      "auto gridok = [&](ll y, ll x) {",
      "    if(y < 0 || x < 0 || y >= h || x >= w) return false;",
      "    return true;",
      "};",
      "vector<vector<ll>> dist(h, vector<ll>(w, -1));",
      "deque<pll> deque_bfs;",
      "dist[0][0] = 0;",
      "deque_bfs.push_front({0, 0});",
      "while(!deque_bfs.empty()) {",
      "\tauto [y, x] = deque_bfs.front(); deque_bfs.pop_front();",
      "\tfor(ll i = 0; i < 4; i++) {",
      "\t\tint next_y = y + dy[i]; ll next_x = x + dx[i];",
      "\t\t// 壁などがあればcontinue",
      "\t\tif(!gridok(next_y, next_x)) continue;",
      "\t\t// ここでコストを計算する！問題によって変更する",
      "\t\tint cost = 1;",
      "\t\tif(dist[next_y][next_x] != -1 && dist[next_y][next_x] <= dist[y][x] + cost) continue;",
      "\t\tdist[next_y][next_x] = dist[y][x] + cost;",
      "\t\tif(cost == 0) deque_bfs.push_front({next_y, next_x}); // コスト0は先頭",
      "\t\telse deque_bfs.push_back({next_y, next_x});  // コスト1は末尾",
      "\t}",
      "}"
    ]
  }
}