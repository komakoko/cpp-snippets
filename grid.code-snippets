  "bfs_grid": {
    "scope": "cpp",
    "prefix": "bfs_grid",
    "body": [
      "ll dy[] = {1, -1, 0, 0};",
      "ll dx[] = {0, 0, 1, -1};",
      "auto gridok = [&](ll y, ll x) {",
      "\tif(y < 0 || x < 0 || y >= h || x >= w) return false;",
      "\tif(false) return false; // 壁などがあればfalseを返す",
      "\treturn true;",
      "};",
      "vector<vector<ll>> dist(h, vector<ll>(w, -1));",
      "queue<pll> queue_bfs;",
      "queue_bfs.push({0, 0});",
      "dist[0][0] = 0;",
      "while(!queue_bfs.empty()) {",
      "\tauto [y, x] = queue_bfs.front();",
      "\tqueue_bfs.pop();",
      "\tfor(ll i = 0; i < 4; i++) {",
      "\t\tint next_y = y + dy[i];",
      "\t\tint next_x = x + dx[i];",
      "\t\tif(!gridok(next_y, next_x) || dist[next_y][next_x] != -1) continue;",
      "\t\tdist[next_y][next_x] = dist[y][x] + 1;",
      "\t\tqueue_bfs.push({next_y, next_x});",
      "\t}",
      "}"
    ]
  },
  "bfs_grid_01": {
    "scope": "cpp",
    "prefix": "bfs_grid_01",
    "body": [
      "auto gridok = [&](ll y, ll x) {",
      "\tif(y < 0 || x < 0 || y >= h || x >= w) return false;",
      "\tif(false) return false; // 壁などがあればfalseを返す",
      "\treturn true;",
      "};",
      "vector<vector<ll>> dist(h, vector<ll>(w, 1LL << 30));",
      "deque<pll> deque_bfs;",
      "dist[0][0] = 0;",
      "deque_bfs.push_front({0, 0});",
      "while(!deque_bfs.empty()) {",
      "\tauto [y, x] = deque_bfs.front();",
      "\tdeque_bfs.pop_front();",
      "\tfor(ll i = 0; i < 4; i++) {",
      "\t\tint next_y = y + dy[i];",
      "\t\tll next_x = x + dx[i];",
      "\t\tif(!gridok(next_y, next_x) || dist[next_y][next_x] != 1LL << 30) continue;",
      "\t\t// ここでコストを計算する！問題によって変更する",
      "\t\tint cost = 1;",
      "\t\tdist[next_y][next_x] = dist[y][x] + cost;",
      "\t\tif(cost == 0) deque_bfs.push_front({next_y, next_x}); // コスト0は先頭",
      "\t\telse deque_bfs.push_back({next_y, next_x});\t\t\t  // コスト1は末尾",
      "\t}",
      "}"
    ]
  },
  "bfs_grid_01_multiplexing": {
    "scope": "cpp",
    "prefix": "bfs_grid_01_multiplexing",
    "body": [
      "ll dy[] = {1, -1, 0, 0};",
      "ll dx[] = {0, 0, 1, -1};",
      "auto gridok = [&](ll y, ll x) {",
      "\tif(y < 0 || x < 0 || y >= h || x >= w) return false;",
      "\tif(false) return false; // 壁などがあればfalseを返す",
      "\treturn true;",
      "};",
      "ll states = 1;",
      "vector dist(states, vector(h, vector<ll>(w, -1)));",
      "struct State {",
      "\tll type, y, x;",
      "};",
      "deque<State> deque_bfs;",
      "dist[0][0][0] = 0;",
      "deque_bfs.push_back({0, 0, 0});",
      "while(!deque_bfs.empty()) {",
      "\tauto [type, y, x] = deque_bfs.front();",
      "\tdeque_bfs.pop_front();",
      "\trep(i, 4) {",
      "\t\tll next_y = y + dy[i];",
      "\t\tll next_x = x + dx[i];",
      "\t\tif(!gridok(next_y, next_x)) continue;",
      "\t\t// 移動後の状態を決める",
      "\t\tll next_type = 0;",
      "\t\t// ここでコストを計算する！問題によって変更する",
      "\t\tll cost = 1;",
      "\t\tll next_dist = dist[type][y][x] + cost;",
      "\t\tif(dist[next_type][next_y][next_x] != -1 && dist[next_type][next_y][next_x] <= next_dist) continue;",
      "\t\tdist[next_type][next_y][next_x] = next_dist;",
      "\t\tif(cost == 0) deque_bfs.push_front({next_type, next_y, next_x});",
      "\t\telse deque_bfs.push_back({next_type, next_y, next_x});",
      "\t}",
      "}"
    ]
  }
