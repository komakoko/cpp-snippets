{
  "trie": {
    "scope": "cpp",
    "prefix": "trie",
    "body": [
      "struct Node {",
      "\tint child[2] = {-1, -1};",
      "\tll count = 0;",
      "};",
      "vector<Node> trie(1);",
      "",
      "auto add = [&](string &s) {",
      "\tint v = 0;",
      "\ttrie[v].count++;",
      "\tfor(char c : s) {",
      "\t\tint b = c - '0';",
      "\t\tif(trie[v].child[b] == -1) {",
      "\t\t\ttrie[v].child[b] = trie.size();",
      "\t\t\ttrie.emplace_back();",
      "\t\t}",
      "\t\tv = trie[v].child[b];",
      "\t\ttrie[v].count++;",
      "\t}",
      "};",
      "",
      "auto erase = [&](string &s) {",
      "\tint v = 0;",
      "\ttrie[v].count--;",
      "\tfor(char c : s) {",
      "\t\tint b = c - '0';",
      "\t\tv = trie[v].child[b];",
      "\t\ttrie[v].count--;",
      "\t}",
      "};",
      "auto rank = [&](string &s) -> ll {",
      "\tint v = 0;",
      "\tll res = 0;",
      "\tfor(char c : s) {",
      "\t\tint b = c - '0';",
      "\t\tif(b == 1) {",
      "\t\t\tif(trie[v].child[0] != -1) res += trie[trie[v].child[0]].count;",
      "\t\t}",
      "\t\tv = trie[v].child[b];",
      "\t}",
      "\tres += trie[v].count;",
      "\treturn res;",
      "};"
    ],
    "description": "二分Trie：同じ長さの01文字列の追加・削除・順位（eraseとrankは登録済み文字列に使用）"
  }
}
