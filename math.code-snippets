    "prefix": "yakusuu",
    "body": [
      "vector<ll> calc_divisors (ll k) { // O(√k) で約数を列挙",
      "\tvector<ll> divisor;",
      "\tfor (ll i = 1; i * i <= k; i++) {",
      "\t\tif (k % i == 0) {",
      "\t\t\tdivisor.push_back(i);",
      "\t\t\tif (i == k / i) continue;",
      "\t\t\tdivisor.push_back(k / i);",
      "\t\t}",
      "\t}",
      "\treturn divisor;",
      "}"
    ],
    "description": "O(√k) で約数を列挙"
  },
  "comb_ll": {
    "scope": "cpp",
    "prefix": "comb_ll",
    "description": "nCk(ll)",
    "body": [
      "ll comb(ll n, ll k) {",
      "\tif(n < 0 || k < 0 || n < k) return 0; // おかしな引数では0を返す",
      "\tif(k > n - k) k = n - k;",
      "\tll result = 1;",
      "\tfor(ll i = 0; i < k; i++) result *= n-i;",
      "\tfor(ll i = 1; i <= k; i++) result /= i;",
      "\treturn result;",
      "}"
    ]
  }
}