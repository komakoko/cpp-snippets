    "body": [
      "auto check = [&](ll x) -> bool{",
      "\treturn true;",
      "};",
      "ll ng = -1; ll ok = 1LL<<60;",
      "while(abs(ok-ng) > 1) {",
      "\tll mid = (ok + ng) / 2;",
      "\tif(check(mid)) ok = mid;",
      "\telse ng = mid;",
      "}"
    ],
    "description": "二部探索"
  },
  "ternarysearch": {
    "scope": "cpp",
    "prefix": "ternarysearch",
    "body": [
      "auto f = [&](ll x) -> ll {",
      "\treturn ${1:0};",
      "};",
      "ll low = ${2:0}; ll high = ${3:1LL<<60};",
      "while(high - low > 3) {",
      "\tll mid1 = low + (high - low) / 3;",
      "\tll mid2 = high - (high - low) / 3;",
      "\tif(f(mid1) < f(mid2)) low = mid1; // 最大化",
      "\t// if(f(mid1) > f(mid2)) low = mid1; // 最小化",
      "\telse high = mid2;",
      "}",
      "ll ans = low;",
      "for(ll x = low; x <= high; x++) {",
      "\tif(f(ans) < f(x)) ans = x; // 最大化",
      "\t// if(f(ans) > f(x)) ans = x; // 最小化",
      "}"
    ],
    "description": "三分探索"
  },
